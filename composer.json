{
    "name": "admin/family",
    "description": "Application de gestion d'arbre familial (PHP, MVC maison)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "Core/",
            "Src\\": "Src/"
        },
        "classmap": [
            "Src/App.php",
            "Src/Auth.php",
            "Src/Session.php",
            "modele/"
        ],
        "files": [
            "helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}

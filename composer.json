{
    "name": "admin/family",
    "description": "Application de gestion d'arbre familial (PHP, MVC maison)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Src\\": "src/"
        },
        "classmap": [
            "legacy/src/"
        ],
        "files": [
            "helpers.php"
        ]
    },
    "scripts": {
        "test": [
            "@php tests/smoke.php",
            "@php tests/security.php",
            "@php tests/static_export.php"
        ],
        "migrate": "@php bin/migrate.php",
        "export:static": "@php bin/export-static.php",
        "export:family-pages": "@php bin/export-family-pages.php",
        "lint": "find app bin bootstrap config core public routes src tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}

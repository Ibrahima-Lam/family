{
    "name": "admin/family",
    "description": "Application de gestion d'arbre familial (PHP, MVC maison)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/",
            "Src\\": "src/"
        },
        "classmap": [
            "legacy/src/"
        ],
        "files": [
            "helpers.php"
        ]
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
